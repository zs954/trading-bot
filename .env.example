# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/quant

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OKX API (Get from https://www.okx.com/account/my-api)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# OKX URLs (Different regions may have different URLs)
OKX_BASE_URL=https://www.okx.com
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_PRIVATE_URL=wss://ws.okx.com:8443/ws/v5/private
OKX_WS_BUSINESS_URL=wss://ws.okx.com:8443/ws/v5/business

# Trading Mode
# IMPORTANT: Set to false for production safety
OKX_SIMULATED=true
LIVE_TRADING_ENABLED=false

# Risk Control (USD Value)
MAX_ORDER_USDT=50
MAX_DAILY_LOSS_USDT=100
MAX_POSITION_USDT=500
MAX_LEVERAGE=3
MAX_CONSECUTIVE_LOSSES=5

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ENCRYPTION_KEY=change-this-to-a-32-byte-encryption-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
